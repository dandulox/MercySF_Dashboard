FROM rust:1-bookworm AS builder
WORKDIR /build
COPY sfapi-bridge/Cargo.toml sfapi-bridge/Cargo.lock ./
COPY sfapi-bridge/src ./src
RUN cargo build --release

FROM debian:bookworm-slim
RUN apt-get update -qq && apt-get install -y -qq --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/*
COPY --from=builder /build/target/release/mercy-sfapi-bridge /usr/local/bin/mercy-sfapi-bridge
ENTRYPOINT ["/usr/local/bin/mercy-sfapi-bridge"]
